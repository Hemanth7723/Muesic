<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ambient glow circle behind headphones -->
    <path
        android:pathData="M 54,54 m -28,0 a 28,28 0 1,0 56,0 a 28,28 0 1,0 -56,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="30"
                android:type="radial">
                <item android:color="#307928CA" android:offset="0.0" />
                <item android:color="#1800E5FF" android:offset="0.6" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer Headband Glow -->
    <path
        android:pathData="M 32,56 C 32,38 41,27 54,27 C 67,27 76,38 76,56"
        android:strokeWidth="6"
        android:strokeColor="#4000E5FF"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- Headband Primary -->
    <path
        android:pathData="M 32,56 C 32,38 41,27 54,27 C 67,27 76,38 76,56"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="32"
                android:startY="27"
                android:endX="76"
                android:endY="56"
                android:type="linear">
                <item android:color="#00F5D4" android:offset="0.0" />
                <item android:color="#00B4D8" android:offset="0.4" />
                <item android:color="#7928CA" android:offset="0.8" />
                <item android:color="#FF0080" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Headphone Pivot & Arm -->
    <path
        android:pathData="M 32,54 L 32,58"
        android:strokeWidth="3.5"
        android:strokeColor="#00F5D4"
        android:strokeLineCap="round" />

    <!-- Left Ear Cup (Pill) -->
    <path
        android:pathData="M 28,53 C 25,53 23,56 23,62 C 23,68 25,71 28,71 C 31,71 33,68 33,62 C 33,56 31,53 28,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="23"
                android:startY="53"
                android:endX="33"
                android:endY="71"
                android:type="linear">
                <item android:color="#00F5D4" android:offset="0.0" />
                <item android:color="#0096C7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Left Ear Cup Cushion Highlight -->
    <path
        android:pathData="M 27,56 C 26,56 25,58 25,62 C 25,66 26,68 27,68 C 28,68 29,66 29,62 C 29,58 28,56 27,56 Z"
        android:fillColor="#40FFFFFF" />

    <!-- Right Headphone Pivot & Arm -->
    <path
        android:pathData="M 76,54 L 76,58"
        android:strokeWidth="3.5"
        android:strokeColor="#FF0080"
        android:strokeLineCap="round" />

    <!-- Right Ear Cup (Pill) -->
    <path
        android:pathData="M 80,53 C 77,53 75,56 75,62 C 75,68 77,71 80,71 C 83,71 85,68 85,62 C 85,56 83,53 80,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="75"
                android:startY="53"
                android:endX="85"
                android:endY="71"
                android:type="linear">
                <item android:color="#9D4EDD" android:offset="0.0" />
                <item android:color="#FF0080" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right Ear Cup Cushion Highlight -->
    <path
        android:pathData="M 79,56 C 78,56 77,58 77,62 C 77,66 78,68 79,68 C 80,68 81,66 81,62 C 81,58 80,56 79,56 Z"
        android:fillColor="#40FFFFFF" />

    <!-- Soundwave Equalizer Spectrum in center -->
    <!-- Bar 1 (Left) -->
    <path
        android:pathData="M 40,68 L 40,58"
        android:strokeWidth="3"
        android:strokeColor="#00F5D4"
        android:strokeLineCap="round" />

    <!-- Bar 2 (Mid-Left) -->
    <path
        android:pathData="M 46,72 L 46,50"
        android:strokeWidth="3"
        android:strokeColor="#00B4D8"
        android:strokeLineCap="round" />

    <!-- Bar 3 (Center Peak - Glowing White/Cyan) -->
    <path
        android:pathData="M 54,76 L 54,43"
        android:strokeWidth="3.5"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />

    <!-- Bar 4 (Mid-Right) -->
    <path
        android:pathData="M 62,72 L 62,49"
        android:strokeWidth="3"
        android:strokeColor="#B5179E"
        android:strokeLineCap="round" />

    <!-- Bar 5 (Right) -->
    <path
        android:pathData="M 68,68 L 68,57"
        android:strokeWidth="3"
        android:strokeColor="#FF0080"
        android:strokeLineCap="round" />

    <!-- Music Note accent above center bar -->
    <path
        android:pathData="M 54,39 C 55,39 56,38 56,37 C 56,36 55,35 54,35 C 53,35 52,36 52,37 C 52,38 53,39 54,39 Z"
        android:fillColor="#FFFFFF" />
</vector>
